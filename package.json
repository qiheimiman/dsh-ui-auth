{
  "name": "dsh-ui-auth",
  "version": "0.6.5",
  "description": "DSH Web UI 认证网关（精简版）：登录保护全部 HTTP/WS 接口；仅保留登录功能。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "build",
    "docs",
    "assets",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build/client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --check lib/index.js && node --check lib/client.js && node test/client-smoke.cjs && node test/login-page-check.mjs",
    "prepack": "npm test",
    "verify:clean": "npm run build && git diff --exit-code -- lib",
    "docs:matrix": "node build/docs-matrix.mjs --run SECURITY.md"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.5-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auth",
    "authentication",
    "login"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0QwQ0/dsh-ui-auth.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
